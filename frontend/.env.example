# Frontend Environment Variables (Production)

# Backend API URL (your Render backend URL)
VITE_API_URL=https://your-backend.onrender.com/api

# ML Service URL (your Render ML service URL)
VITE_ML_URL=https://your-ml-service.onrender.com

# For local development, leave empty to use proxy
# VITE_API_URL=
# VITE_ML_URL=
