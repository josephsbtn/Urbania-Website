# Backend Environment Variables

# Local Development
MONGODB_URI=mongodb://127.0.0.1:27017/urbania
PORT=8000
NODE_ENV=development
REDIS_URL=redis://localhost:6379

# Production (MongoDB Atlas + Render)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/urbania?retryWrites=true&w=majority
# NODE_ENV=production
# PORT=8000

# Notes:
# - Replace username, password, and cluster with your MongoDB Atlas details
# - Render will use PORT from environment (default 10000), but we set 8000
# - Redis is optional (will error but app still works)
